# ---------------------------------------------------------------------------
# MongoDB (required). Never hardcoded in code -- the app refuses to start
# without these.
# ---------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=lead_followup_db

# ---------------------------------------------------------------------------
# Feature gate: the entire "Analyze New Call" section (frontend) and its
# ingestion/processing endpoints (backend) are hidden/disabled unless this is
# explicitly set to true. Leave unset/false to run as a read-only dashboard
# over already-seeded data.
# ---------------------------------------------------------------------------
CALL_ANALYZER_ENABLED=false

# ---------------------------------------------------------------------------
# Vertex AI / Gemini (required for transcription + analysis).
# The backend alone talks to Google Cloud; nothing here reaches the browser.
# ---------------------------------------------------------------------------
# A Google Cloud project with the Vertex AI API enabled:
#   gcloud services enable aiplatform.googleapis.com --project=<PROJECT_ID>
GOOGLE_CLOUD_PROJECT=
# Vertex region. "global" and regional endpoints (us-central1, asia-south1, ...) both work.
GOOGLE_CLOUD_LOCATION=us-central1
# Gemini model id on Vertex, e.g. gemini-2.5-flash or gemini-2.5-pro.
VERTEX_AI_MODEL=gemini-2.5-flash
# Path to a service-account JSON key. Leave BLANK to use Application Default
# Credentials (`gcloud auth application-default login`). Never commit the key.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_GENAI_USE_VERTEXAI=true

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
# Which speech-to-text implementation to use. Only "vertex" (Gemini audio
# understanding) is implemented; "local" and "gcp-stt" are registered and fail
# with an explanatory message.
TRANSCRIPTION_PROVIDER=vertex
# When Gemini is unreachable or returns invalid JSON, fall back to the
# deterministic keyword analyzer so the pipeline still completes. The result is
# flagged `degraded`. Set false for strict "AI or FAILED" behaviour.
ANALYSIS_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Audio
# ---------------------------------------------------------------------------
# local = uploaded files are stored on this server under AUDIO_UPLOAD_DIR.
# url   = only the "Audio URL" input is offered; nothing is stored locally.
AUDIO_STORAGE_MODE=local
# Show the audio player in the lead details modal.
AUDIO_PLAYBACK_ENABLED=true
# Relative to backend/ unless absolute.
AUDIO_UPLOAD_DIR=uploads
# Gemini accepts ~20 MB of inline audio per request; larger files would need
# Cloud Storage, which is out of scope for this MVP.
MAX_AUDIO_MB=20
ALLOWED_AUDIO_TYPES=mp3,wav,m4a,ogg,webm

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
