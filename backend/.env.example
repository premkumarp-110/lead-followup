# ---------------------------------------------------------------------------
# MongoDB (required). Never hardcoded in code -- the app refuses to start
# without these.
# ---------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=lead_followup_db

# How long to wait for a usable MongoDB server before failing (milliseconds).
# A local mongod answers instantly. A hosted cluster (mongodb+srv://) needs a
# TLS handshake to several hosts and can take 6-12s from some networks, so the
# default is generous. Raise it on a slow link.
MONGODB_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Lead Call API (the CRM) -- the upstream source of leads, calls, transcripts
# and recordings. https://lead-call-api.codingpuppet.com
#
# The key is a bearer credential to real customer conversations. It lives here
# only: it is never returned by GET /api/config and never reaches the browser.
#
# Checked lazily, so the app boots, seeds and serves the whole dashboard
# without it. Only call-recording playback needs it.
# ---------------------------------------------------------------------------
LEAD_CALL_API_URL=https://lead-call-api.codingpuppet.com
LEAD_CALL_API_KEY=

# ---------------------------------------------------------------------------
# Vertex AI / Gemini (required for transcription).
# The backend alone talks to Google Cloud; nothing here reaches the browser.
# ---------------------------------------------------------------------------
# A Google Cloud project with the Vertex AI API enabled:
#   gcloud services enable aiplatform.googleapis.com --project=<PROJECT_ID>
GOOGLE_CLOUD_PROJECT=
# Vertex region. "global" and regional endpoints (us-central1, asia-south1, ...) both work.
GOOGLE_CLOUD_LOCATION=us-central1
# Gemini model id on Vertex, e.g. gemini-2.5-flash or gemini-2.5-pro.
VERTEX_AI_MODEL=gemini-2.5-flash
# Path to a service-account JSON key. Leave BLANK to use Application Default
# Credentials (`gcloud auth application-default login`). Never commit the key.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_GENAI_USE_VERTEXAI=true

# ---------------------------------------------------------------------------
# Call-outcome analysis (OpenAI-compatible chat-completions endpoint).
# Used ONLY for turning a transcript into outcome/follow-up JSON -- separate
# from Vertex AI above, which still does transcription. If this isn't
# configured, and ANALYSIS_FALLBACK_ENABLED=true, the deterministic keyword
# analyzer is used instead of failing the call.
# ---------------------------------------------------------------------------
CALL_ANALYSIS_API_URL=https://ai.hyrenet-staging.in/v1/chat/completions
# API key for the endpoint above. Required for AI-based outcome analysis;
# never commit a real key here.
CALL_ANALYSIS_API_KEY=
CALL_ANALYSIS_MODEL=global.anthropic.claude-sonnet-5

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
# Which speech-to-text implementation to use. Only "vertex" (Gemini audio
# understanding) is implemented; "local" and "gcp-stt" are registered and fail
# with an explanatory message.
TRANSCRIPTION_PROVIDER=vertex
# When the call-outcome analysis endpoint is unreachable or returns invalid
# JSON, fall back to the deterministic keyword analyzer so the pipeline still
# completes. The result is flagged `degraded`. Set false for strict "AI or
# FAILED" behaviour.
ANALYSIS_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Audio
# ---------------------------------------------------------------------------
# There is no upload path: recordings are fetched from the CRM with the
# LEAD_CALL_API_KEY above and cached on disk. Recordings never change, so the
# cache never expires -- delete the directory to reclaim the space.
#
# The cache is what makes playback work at all: a browser cannot attach the
# CRM's X-API-Key header to an <audio src>, and the CRM sends no
# content-length and ignores Range, so a live passthrough has no duration and
# no seeking.
AUDIO_PLAYBACK_ENABLED=true
# Relative to backend/ unless absolute.
AUDIO_CACHE_DIR=uploads

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Follow-up alert emails (SMTP).
# One daily digest per BD listing their OVERDUE and DUE-TODAY follow-ups.
# Off by default -- turn on only after SMTP_USER/SMTP_PASSWORD are set.
#
# The scheduler is in-process: run a SINGLE uvicorn worker, or each worker
# sends its own digest. Scheduled runs are deduped to once per BD per IST day;
# a manual send from the UI always goes through.
FOLLOWUP_ALERTS_ENABLED=false
# Hour/minute of day (0-23 / 0-59, Asia/Kolkata) the daily digest is sent.
FOLLOWUP_ALERT_HOUR=9
FOLLOWUP_ALERT_MINUTE=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Mailbox the alerts are sent from.
SMTP_USER=
# An app password (not your account password). For Gmail: Google Account ->
# Security -> 2-Step Verification -> App passwords. Never commit a real one.
SMTP_PASSWORD=
# From: header shown to recipients. Defaults to SMTP_USER when blank.
SMTP_FROM_EMAIL=
