# MongoDB connection settings -- never hardcode these in code.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=lead_followup_db

# Call analysis backend. "keyword" = deterministic MVP analyzer.
# A future "llm" implementation plugs in here without touching routes.
ANALYZER_BACKEND=keyword

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
