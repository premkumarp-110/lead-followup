# Root .env.example -- used by docker-compose.yml. For local development copy
# backend/.env.example -> backend/.env and frontend/.env.example -> frontend/.env.

# Feature gate -- see backend/.env.example
# Lead Call API (the CRM). The key is a credential to real customer calls --
# it stays server-side and is never exposed to the browser. Only recording
# playback needs it; everything else works without it.
LEAD_CALL_API_URL=https://lead-call-api.codingpuppet.com
LEAD_CALL_API_KEY=

# Vertex AI (required for transcription)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
# Host path to a service-account key, mounted read-only into the backend container.
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=./service-account.json

# Call-outcome analysis (OpenAI-compatible endpoint, separate from Vertex AI)
CALL_ANALYSIS_API_URL=https://ai.hyrenet-staging.in/v1/chat/completions
CALL_ANALYSIS_API_KEY=
CALL_ANALYSIS_MODEL=global.anthropic.claude-sonnet-5

# Pipeline / audio
TRANSCRIPTION_PROVIDER=vertex
ANALYSIS_FALLBACK_ENABLED=true
AUDIO_PLAYBACK_ENABLED=true
# Where CRM recordings are cached after their first fetch.
AUDIO_CACHE_DIR=uploads

# Follow-up alert emails (SMTP) -- see backend/.env.example. Off by default;
# never commit real credentials here.
# Daily digest of each BD's overdue + due-today follow-ups.
# In-process scheduler: run ONE backend worker only.
FOLLOWUP_ALERTS_ENABLED=false
FOLLOWUP_ALERT_HOUR=9
FOLLOWUP_ALERT_MINUTE=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
