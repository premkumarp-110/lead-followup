# Root .env.example -- used by docker-compose.yml. For local development copy
# backend/.env.example -> backend/.env and frontend/.env.example -> frontend/.env.

# Feature gate -- see backend/.env.example
CALL_ANALYZER_ENABLED=true

# Vertex AI (required for AI analysis)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
# Host path to a service-account key, mounted read-only into the backend container.
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=./service-account.json

# Pipeline / audio
TRANSCRIPTION_PROVIDER=vertex
ANALYSIS_FALLBACK_ENABLED=true
AUDIO_STORAGE_MODE=local
AUDIO_PLAYBACK_ENABLED=true
MAX_AUDIO_MB=20
